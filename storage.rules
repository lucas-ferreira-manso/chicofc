rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Storage não é mais usado: comprovantes vão em base64 no Firestore (payment_requests),
    // onde a leitura é restrita ao dono e aos admins. Comprovantes antigos continuam
    // abrindo pelo link com token salvo em comprovante_url, que não passa por estas regras.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
