rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Comprovantes: usuário faz upload do próprio; admins podem ler todos
    match /comprovantes/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
