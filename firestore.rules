rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/players/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Perfis dos jogadores
    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      // Jogador pode atualizar só seu próprio nome e foto
      allow update: if isAdmin() ||
        (isOwner(playerId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL']));
      allow delete: if isAdmin();
    }

    // Confirmações de presença nos jogos
    match /attendances/{attendanceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Avulsos temporários
    match /avulsos_temp/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.addedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.addedBy == request.auth.uid);
    }

    // Solicitações de pagamento (jogador cria a própria, admin gerencia)
    match /payment_requests/{docId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Registros de pagamento (somente admin escreve)
    match /payments/{docId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow write: if isAdmin();
    }

    // Escalações dos times
    match /lineups/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Configurações do app (caixinha, pontuação)
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Votações de destaque
    match /votacao/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Tokens de notificação push
    match /fcm_tokens/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isOwner(userId);
    }
  }
}
